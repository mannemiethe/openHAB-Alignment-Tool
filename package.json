{
	"name": "openhab-formatkit",
	"displayName": "openHAB FormatKit",
	"version": "2.3.0",
	"publisher": "ManuelMiethe",
	"contributors": [
		"Mark Hilbush"
	],
	"description": "Modern independent formatter, syntax highlighting, and snippet toolkit for openHAB configuration files.",
	"author": {
		"name": "openHAB FormatKit maintainers",
		"url": "https://github.com/mannemiethe/openHAB-Alignment-Tool"
	},
	"categories": [
		"Formatters",
		"Programming Languages",
		"Snippets",
		"Other"
	],
	"icon": "images/formatkit-icon.png",
	"repository": {
		"url": "https://github.com/mannemiethe/openHAB-Alignment-Tool",
		"type": "git"
	},
	"bugs": {
		"url": "https://github.com/mannemiethe/openHAB-Alignment-Tool/issues"
	},
	"engines": {
		"vscode": "^1.55.0"
	},
	"license": "EPL-2.0",
	"activationEvents": [
		"onLanguage:openhab",
		"onLanguage",
		"onCommand:openhab-formatkit.showDiagnostics",
		"workspaceContains:**/*.items",
		"workspaceContains:**/*.sitemap",
		"workspaceContains:**/*.things"
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "openhab-formatkit.insert-item-generic",
				"category": "openHAB FormatKit",
				"title": "Insert Item"
			},
			{
				"command": "openhab-formatkit.insert-item-switch",
				"category": "openHAB FormatKit",
				"title": "Insert Switch Item"
			},
			{
				"command": "openhab-formatkit.insert-item-dimmer",
				"category": "openHAB FormatKit",
				"title": "Insert Dimmer Item"
			},
			{
				"command": "openhab-formatkit.insert-item-string",
				"category": "openHAB FormatKit",
				"title": "Insert String Item"
			},
			{
				"command": "openhab-formatkit.insert-item-number",
				"category": "openHAB FormatKit",
				"title": "Insert Number Item"
			},
			{
				"command": "openhab-formatkit.insert-item-datetime",
				"category": "openHAB FormatKit",
				"title": "Insert DateTime Item"
			},
			{
				"command": "openhab-formatkit.showDiagnostics",
				"category": "openHAB FormatKit",
				"title": "Show Diagnostics"
			}
		],
		"configuration": {
			"type": "object",
			"title": "openHAB FormatKit",
			"properties": {
				"openhab-formatkit.preserveWhitespace": {
					"type": "boolean",
					"default": false,
					"description": "Preserves any leading whitespace when reformatting an item."
				},
				"openhab-formatkit.newLineAfterItem": {
					"type": "boolean",
					"default": false,
					"description": "Choose if you want to have a new line inserted after each item."
				},
				"openhab-formatkit.formatStyle": {
					"type": "string",
					"default": "Column",
					"enum": [
						"Column",
						"ChannelColumn",
						"Multiline"
					],
					"enumDescriptions": [
						"Formats the files in a column-style. E.g. in an items file each item is one line separated by tabs.",
						"Formats the files in a column-style with each channel parameter in a new line. E.g. in an items file each part of the channel configuration is written in a new line.",
						"Formats the files in a multiline-style. E.g. in an items file each part of an item is written in a new line."
					]
				},
				"openhab-formatkit.minimumIndentAmount": {
					"type": "number",
					"default": 4,
					"description": "Minimum separation of thing or item parts."
				},
				"openhab-formatkit.enableBetaFeatures": {
					"type": "boolean",
					"default": false,
					"description": "Enable beta features like sitemap formatting or thing file formatting."
				}
			}
		},
		"languages": [
			{
				"id": "openhab",
				"aliases": [
					"openHAB",
					"openhab"
				],
				"extensions": [
					".rules",
					".script",
					".items",
					".sitemap",
					".things",
					".persist"
				],
				"configuration": "./meta/language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "openhab",
				"scopeName": "source.openhab",
				"path": "./meta/openhab.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "openhab",
				"path": "./snippets/openhab_items.json"
			},
			{
				"language": "openhab",
				"path": "./snippets/openhab_rules.json"
			},
			{
				"language": "openhab",
				"path": "./snippets/openhab_rules_designpattern.json"
			},
			{
				"language": "openhab",
				"path": "./snippets/openhab_rules_typeconversions.json"
			},
			{
				"language": "openhab",
				"path": "./snippets/openhab_sitemaps.json"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile",
		"test": "node ./out/test/runTest.js"
	},
	"dependencies": {
		"semver": "^7.3.5"
	},
	"devDependencies": {
		"@types/glob": "^7.1.3",
		"@types/mocha": "^8.2.2",
		"@types/node": "^14.14.41",
		"@types/semver": "^7.3.4",
		"@types/vscode": "^1.55.0",
		"glob": "^7.1.6",
		"mocha": "^8.3.2",
		"tslint": "^5.20.1",
		"typescript": "^4.2.4",
		"vscode-test": "^1.5.2"
	},
	"homepage": "https://github.com/mannemiethe/openHAB-Alignment-Tool#readme",
	"keywords": [
		"openHAB",
		"openhab",
		"formatter",
		"formatters",
		"formatting",
		"alignment",
		"aligner",
		"items",
		"sitemap",
		"things",
		"config",
		"configuration",
		"cleanup",
		"smart home",
		"home automation",
		"syntax highlighting",
		"snippets",
		"rules",
		"script",
		"persist",
		"dsl"
	],
	"badges": [
		{
			"url": "https://img.shields.io/badge/openHAB-FormatKit-0f766e",
			"href": "https://www.openhab.org/",
			"description": "openHAB formatter toolkit"
		}
	]
}
